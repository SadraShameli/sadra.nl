{
    "name": "sadra.nl",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "preview": "next build && next start",
        "fix": "bun fmt && bun lint --fix && bun run stylelint:fix",
        "check": "bun run --parallel typecheck lint:check stylelint format:check knip",
        "verify": "bun run fix && bun run --parallel typecheck knip",
        "typecheck": "next typegen && tsc --noEmit",
        "lint:check": "bun lint",
        "format:check": "bun fmt --check",
        "stylelint": "stylelint '**/*.{css,scss}' --cache --cache-strategy content --cache-location node_modules/.cache/stylelint/",
        "stylelint:fix": "bun run stylelint --fix --quiet",
        "knip": "knip --cache",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "cli": "bun --conditions react-server ./src/cli/index.ts",
        "db:bootstrap": "bun ./src/server/db/bootstrap.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "bun run db:bootstrap && drizzle-kit push",
        "db:seed": "bun run cli seed run",
        "db:studio": "drizzle-kit studio",
        "ncu": "bunx npm-check-updates --interactive --format group",
        "prepare": "husky"
    },
